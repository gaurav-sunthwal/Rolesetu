{
  "name": "rolesetu-extension",
  "description": "Rolesetu browser extension: match score on job pages",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:live": "WXT_LIVE=1 wxt build",
    "test": "vitest run",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:live": "WXT_LIVE=1 wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "postinstall": "wxt prepare",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  }
}
