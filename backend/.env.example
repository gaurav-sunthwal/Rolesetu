ENVIRONMENT=local
DEBUG=true

DATABASE_URL=postgresql+asyncpg://user:password@host:5432/rolesetu

# Only the project id is needed to verify ID tokens; the service account is optional.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=

CORS_ORIGINS=["http://localhost:3000"]

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Two server-side Gemini keys, tried in order; a user's own saved key (via the
# dashboard) is the final fallback if both of these fail. See ai/llm_client.py.
LLM_API_KEY_1=
LLM_API_KEY_2=
# Job checks: "local" (no model call, instant) or "llm" (Gemini judges each skill).
MATCH_ENGINE=local
# Local embedding model for skills shown but not named. Off by default; costs ~220 MB of memory.
SEMANTIC_MATCHING=false

LLM_MODEL=gemini-flash-latest
# Used in order when LLM_MODEL is overloaded or unavailable (JSON list).
LLM_FALLBACK_MODELS=["gemini-3.5-flash","gemini-2.5-flash","gemini-flash-lite-latest"]

# Fernet key (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# Encrypts user-supplied LLM API keys at rest. Required if that feature is used.
ENCRYPTION_KEY=

# Google OAuth client, for read-only Gmail access.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
