ENVIRONMENT=local
DEBUG=true

DATABASE_URL=postgresql+asyncpg://user:password@host:5432/rolesetu

# Only the project id is needed to verify ID tokens; the service account is optional.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=
# The service account key file's contents, on one line (Railway: paste as a variable).
# Lets "Delete account" in the admin panel also remove the person's Firebase sign-in.
# Never commit it.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Google accounts allowed into the admin panel (JSON list of verified emails).
ADMIN_EMAILS=[]
# Emailed each time someone signs in for the first time. Empty: nobody.
SIGNUP_ALERT_EMAILS=[]

# Add the admin panel's address here too (http://localhost:3003 in development).
CORS_ORIGINS=["http://localhost:3000"]

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Two server-side Gemini keys, tried in order; a user's own saved key (via the
# dashboard) is the final fallback if both of these fail. See ai/llm_client.py.
LLM_API_KEY_1=
LLM_API_KEY_2=
# Job checks: "local" (no model call, instant) or "llm" (Gemini judges each skill).
MATCH_ENGINE=local
# Local embedding model for skills shown but not named. Off by default; costs ~220 MB of memory.
SEMANTIC_MATCHING=false

LLM_MODEL=gemini-flash-latest
# Used in order when LLM_MODEL is overloaded or unavailable (JSON list).
LLM_FALLBACK_MODELS=["gemini-3.5-flash","gemini-2.5-flash","gemini-flash-lite-latest"]

# Context.dev keys (JSON list), tried in order. Reads job links our own fetch
# cannot. Leave empty to turn the fallback off.
CONTEXT_API_KEYS=[]

# Fernet key (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# Encrypts user-supplied LLM API keys at rest. Required if that feature is used.
ENCRYPTION_KEY=

# Google OAuth client, for read-only Gmail access.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email. Gmail is used when GMAIL_SENDER_REFRESH_TOKEN is set (needs the Google
# client above; get the token with `uv run python -m backend.scripts.gmail_sender_token`),
# else Resend when RESEND_API_KEY is set. With neither, nothing is sent.
# EMAIL_FROM: "Rolesetu <the-sending-account@gmail.com>" with Gmail, or an
# address on a domain verified in Resend.
GMAIL_SENDER_REFRESH_TOKEN=
RESEND_API_KEY=
EMAIL_FROM=Rolesetu <onboarding@resend.dev>
# Hours after someone first signs in before the founder's one-time note goes out.
FEEDBACK_EMAIL_DELAY_HOURS=3
EMAIL_REPLY_TO=

# Social posting from the admin panel. The redirect URIs below must also be
# added to each platform's app settings. Image posts need PUBLIC_API_URL to be
# this API's public https address, because Facebook and Instagram download the image from it.
ADMIN_URL=http://localhost:3003
PUBLIC_API_URL=http://localhost:8000
# LinkedIn developer app with "Sign In with LinkedIn using OpenID Connect" and "Share on LinkedIn".
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/v1/admin/social/linkedin/callback
LINKEDIN_API_VERSION=202608
# Meta app (Facebook Login for Business) for Facebook Pages and Instagram business accounts.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:8000/api/v1/admin/social/meta/callback
META_GRAPH_VERSION=v23.0

SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
