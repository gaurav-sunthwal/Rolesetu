# Copy to .env.local. The Firebase values are the same ones the dashboard uses.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# The Rolesetu API. Who counts as an admin is decided there (ADMIN_EMAILS), not here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# When the panel runs on localhost, it uses this backend if it is running,
# and falls back to NEXT_PUBLIC_API_BASE_URL otherwise. Defaults to http://localhost:8000.
NEXT_PUBLIC_LOCAL_API_BASE_URL=

# Show the Social page (posting to LinkedIn, Facebook and Instagram). Off unless "true".
NEXT_PUBLIC_SOCIAL_ENABLED=
